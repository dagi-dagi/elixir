# Copy to .env.local (gitignored) and fill in. Never put real credentials in this file — it is committed.
# NEXT_PUBLIC_* values are inlined into the browser bundle, i.e. public.

# Public URL of this app — encoded into QR codes and used for metadata.
# Must be reachable from customers' phones: in development use this PC's LAN IP,
# e.g. http://192.168.1.20:3000 (its host is also allowed by the dev server).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extra hostnames allowed to load dev-server resources (comma-separated, dev only).
# DEV_ALLOWED_ORIGINS=192.168.1.20,my-tunnel.example.com

# Which gateway implementation to use: "mock" (in-browser simulator) or "mqtt".
NEXT_PUBLIC_DISPENSER_TRANSPORT=mock

# Show developer helpers (an "Open phone simulator" link) on the kiosk. Defaults to on outside production.
# NEXT_PUBLIC_KIOSK_DEV_TOOLS=true

# ---- MQTT (used when NEXT_PUBLIC_DISPENSER_TRANSPORT=mqtt) ----
# Browsers can only speak MQTT over WebSockets: use ws:// or wss:// (wss required on HTTPS pages).
NEXT_PUBLIC_MQTT_URL=wss://your-broker.example.com:8084/mqtt
# Credentials are visible to anyone who opens the page — restrict them with broker ACLs.
NEXT_PUBLIC_MQTT_USERNAME=
NEXT_PUBLIC_MQTT_PASSWORD=
NEXT_PUBLIC_MQTT_TOPIC_PREFIX=elixir
# NEXT_PUBLIC_MQTT_CLIENT_ID_PREFIX=elixir
NEXT_PUBLIC_MQTT_QOS=1
NEXT_PUBLIC_MQTT_KEEPALIVE_SECONDS=30
NEXT_PUBLIC_MQTT_RECONNECT_PERIOD_MS=2000
NEXT_PUBLIC_MQTT_CONNECT_TIMEOUT_MS=10000
NEXT_PUBLIC_MQTT_PUBLISH_TIMEOUT_MS=8000

# Topic templates ({dispenserId} is substituted). Defaults shown.
# NEXT_PUBLIC_MQTT_TOPIC_SCAN=elixir/dispensers/{dispenserId}/scan
# NEXT_PUBLIC_MQTT_TOPIC_SESSION=elixir/dispensers/{dispenserId}/session
# NEXT_PUBLIC_MQTT_TOPIC_DISPENSE=elixir/dispensers/{dispenserId}/dispense
# NEXT_PUBLIC_MQTT_TOPIC_STATUS=elixir/dispensers/{dispenserId}/status
# NEXT_PUBLIC_MQTT_TOPIC_QR_TOKEN=elixir/dispensers/{dispenserId}/qr-token   (retained; kiosk → controller)

# ---- Mock simulator ----
NEXT_PUBLIC_MOCK_LATENCY_MS=600
# Simulated time for the customer to place their cup before pouring starts automatically.
NEXT_PUBLIC_MOCK_CUP_DELAY_MS=3000
NEXT_PUBLIC_MOCK_FLOW_RATE=1
# 0–1 chance a simulated dispense fails — set to e.g. 0.5 to exercise the error screen.
NEXT_PUBLIC_MOCK_FAILURE_RATE=0

# ---- Flow timings ----
# Phone: wait for the "session" signal after scanning.
NEXT_PUBLIC_SESSION_ACK_TIMEOUT_MS=10000
# Phone + kiosk: time the customer has to pick an amount.
NEXT_PUBLIC_KIOSK_SELECTION_TIMEOUT_MS=60000
# After the amount is sent: how long to wait for a cup under the nozzle.
NEXT_PUBLIC_CUP_TIMEOUT_MS=60000
NEXT_PUBLIC_KIOSK_DISPENSE_STALL_TIMEOUT_MS=30000
# Bottle lifted mid-pour: the refill ends if it isn't put back within this time.
NEXT_PUBLIC_PAUSE_TIMEOUT_MS=15000
# Kiosk rotates its one-time QR token this often while idle.
NEXT_PUBLIC_QR_TOKEN_ROTATE_MS=300000
# "FULLY CHARGED!" then "THANKS FOR REFILLING!" before returning to the QR.
NEXT_PUBLIC_KIOSK_COMPLETE_MS=2600
NEXT_PUBLIC_KIOSK_THANK_YOU_MS=2000
NEXT_PUBLIC_KIOSK_ERROR_MS=10000

# ---- Mock firmware service (npm run firmware) ----
# Reuses the MQTT settings, topics and timings above. Override only what should differ.
# FIRMWARE_MQTT_URL=
# FIRMWARE_MQTT_USERNAME=        # ideally a separate broker user with firmware-side ACLs
# FIRMWARE_MQTT_PASSWORD=
# FIRMWARE_DISPENSERS=1,2        # simulate only these ids (default: all in config/dispensers.ts)
# FIRMWARE_AUTO_CUP=true         # simulated customer places the cup automatically
# FIRMWARE_CUP_DELAY_MS=3000     # …after this long (defaults to NEXT_PUBLIC_MOCK_CUP_DELAY_MS)
# FIRMWARE_CUP_REMOVE_DELAY_MS=2500
# FIRMWARE_PAUSE_TIMEOUT_MS=15000  # defaults to NEXT_PUBLIC_PAUSE_TIMEOUT_MS
# FIRMWARE_FLOW_RATE=            # L/s for every dispenser (default: per-dispenser flow rate)
# FIRMWARE_FAILURE_RATE=0        # 0–1 chance a pour faults part-way
# FIRMWARE_LATENCY_MS=600        # delay before answering a scan
# FIRMWARE_PROGRESS_INTERVAL_MS=500
# FIRMWARE_UI_HOST=127.0.0.1     # dashboard has no auth — keep it on localhost
# FIRMWARE_UI_PORT=4001
