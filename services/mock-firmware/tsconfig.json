{
  // Runs directly on Node's built-in TypeScript type stripping (no build step),
  // so only erasable syntax is allowed and imports keep their .ts extension.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": "../..",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["./**/*.ts"]
}
